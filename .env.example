# Copy to .env and fill in. Never commit .env; production values live in Render.

NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=
# Behind a proxy (Render): true, so rate limits see each user's real address.
TRUST_PROXY=false

DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=5

# Long random values, different per environment:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_REFRESH_TOKEN_EXPIRES_IN=12h

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_SECONDS=60

# console (codes printed in the log) or live (sent by Africa's Talking).
SMS_MODE=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
SMS_COST_PER_MESSAGE=
SMS_SCHEDULER_INTERVAL_MS=

# The one administrator, created at start-up.
ADMIN_PHONE=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# 64 hex characters (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# The customer agent's read-only figures (/api/agent-data). Empty switches it off.
# At least 32 characters, the same value as KODI_API_TOKEN in the agent:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_TOKEN=

# Cloudflare R2, for uploaded files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Kodi's own billing: landlords pay Kodi by M-Pesa STK push to Kodi's
# till (Buy Goods only, no paybill). Server only, never in the frontend. Empty: the Pay button says
# payments are not set up, and the admin records payments by hand.
# Sandbox first (developer.safaricom.co.ke: shortcode and till both
# 174379, with the test passkey from the Daraja docs); production once
# Safaricom approves the till for Daraja.
KODI_MPESA_ENV=sandbox
KODI_MPESA_CONSUMER_KEY=
KODI_MPESA_CONSUMER_SECRET=
# The till's store (head office) number, and the till itself.
KODI_MPESA_SHORTCODE=
KODI_MPESA_TILL_NUMBER=
KODI_MPESA_PASSKEY=
# At least 32 random characters; part of the address Safaricom sends
# results to (PUBLIC_API_URL must be https). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KODI_MPESA_RESULT_SECRET=
